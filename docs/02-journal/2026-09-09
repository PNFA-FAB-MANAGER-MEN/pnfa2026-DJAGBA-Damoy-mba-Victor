from machine import Pin
import time

========== CONFIG ==========
PIN_BOUTON = 2      # D2 sur XIAO
PIN_LED = 3         # D3 sur XIAO

TEMPS_ANTI_REBOND = 50   # ms pour ignorer les rebonds
TEMPS_APPUI_LONG = 800   # ms pour considérer un appui long

========== INIT ==========
bouton = Pin(PIN_BOUTON, Pin.IN, Pin.PULL_UP)
led = Pin(PIN_LED, Pin.OUT)

etat_led = False
led.value(etat_led)

dernier_etat_bouton = 1
dernier_changement = time.ticks_ms()
appui_en_cours = False
temps_appui_debut = 0

print("XIAO démarrée. Appui court = Toggle. Appui long = Blink 5 fois")

========== FONCTIONS ==========
def toggle_led():
    global etat_led
    etat_led = not etat_led
    led.value(etat_led)
    print("LED:", "ON" if etat_led else "OFF")

def blink_led(nombre=5, delai=200):
    print(f"Blink x{nombre}")
    for i in range(nombre):
        led.value(1)
        time.sleep_ms(delai)
        led.value(0)
        time.sleep_ms(delai)
    led.value(etat_led) # remet l'état d'avant

========== BOUCLE PRINCIPALE ==========
while True:
    etat_actuel = bouton.value()
    maintenant = time.ticks_ms()

    # Détection changement d'état avec anti-rebond
    if etat_actuel != dernier_etat_bouton:
        if time.ticks_diff(maintenant, dernier_changement) > TEMPS_ANTI_REBOND:
            dernier_changement = maintenant
            dernier_etat_bouton = etat_actuel

            # Bouton appuyé = 0
            if etat_actuel == 0:
                appui_en_cours = True
                temps_appui_debut = maintenant
            # Bouton relaché = 1
            else:
                if appui_en_cours:
                    duree_appui = time.ticks_diff(maintenant, temps_appui_debut)
                   
                    if duree_appui < TEMPS_APPUI_LONG:
                        # Appui court
                        toggle_led()
                    else:
                        # Appui long
                        blink_led(5, 150)
                   
                    appui_en_cours = False

    time.sleep_ms(10) # pour ne pas saturer le CPU
*Comment ça marche sur ton circuit*
Action Résultat
**Appui court < 0.8s** La LED s'allume/s'éteint. Toggle
**Appui long > 0.8s** La LED clignote 5 fois puis revient à son état
**Au démarrage** La LED est éteinte
*Points clés pour que ça marche*

1.  *Branchement*: Vérifie que D2 va bien sur le point entre R1 et SW1. D3 va sur R2 puis D1
2.  *R2*: Mets 470Ω. Avec 3.3V ça donne ∼5mA, nickel pour la LED
3.  *Alim*: Branche la XIAO en USB. U2 ne sert que si tu alimentes en externe sur VCC
4.  *Débogage*: Ouvre le Shell de Thonny. Tu verras les `print()` pour savoir si le bouton est détecté

